{
  "name": "@lumen/player",
  "version": "0.1.0",
  "description": "Beautiful. Simple. Unbreakable. Lightweight. A web-first video player built on Web Components.",
  "type": "module",
  "license": "MIT",
  "author": "",
  "homepage": "https://github.com/kuyamcliff/lumen",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuyamcliff/lumen.git"
  },
  "keywords": [
    "video",
    "player",
    "html5-video",
    "hls",
    "web-component",
    "media-player"
  ],
  "main": "./dist/lumen.umd.cjs",
  "module": "./dist/lumen.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lumen.js",
      "require": "./dist/lumen.umd.cjs"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/types/vue/index.d.ts",
      "import": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/types/svelte/index.d.ts",
      "import": "./dist/svelte.js"
    },
    "./plugins/ads": {
      "types": "./dist/types/plugins/ads/index.d.ts",
      "import": "./dist/plugins/ads.js"
    },
    "./plugins/ambient": {
      "types": "./dist/types/plugins/ambient.d.ts",
      "import": "./dist/plugins/ambient.js"
    },
    "./offline": {
      "types": "./dist/types/offline.d.ts",
      "import": "./dist/offline.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./src/index.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build && LUMEN_FORMAT=umd vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "npm run build && node scripts/check-size.mjs",
    "test:browser": "node scripts/browser-test.mjs"
  },
  "peerDependencies": {
    "dashjs": "^4.7.0 || ^5.0.0",
    "hls.js": "^1.5.0",
    "mp4box": "^2.4.0",
    "react": ">=17",
    "svelte": ">=4",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "hls.js": {
      "optional": true
    },
    "mp4box": {
      "optional": true
    },
    "dashjs": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "hls.js": "^1.5.15",
    "jsdom": "^30.0.1",
    "mp4box": "^2.4.1",
    "react": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5",
    "vue": "^3.5.41",
    "playwright": "^1.48.0"
  }
}
